{
  "name": "tecli",
  "version": "0.4.0",
  "description": "Time entry CLI, web UI, and TUI for Costpoint.",
  "bin": {
    "te": "cli.js"
  },
  "scripts": {
    "server": "node cli.js server",
    "tui": "node cli.js tui",
    "mcp": "node mcp-server.js",
    "test": "node --test test/**/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 test/browser/*.spec.js",
    "mock": "node mock/server.js",
    "lint": "eslint .",
    "format": "git ls-files -z | xargs -0 prettier --write --ignore-unknown",
    "format:check": "git ls-files -z | xargs -0 prettier --check --ignore-unknown"
  },
  "keywords": [
    "cli",
    "costpoint",
    "timesheet",
    "time-entry"
  ],
  "author": "Ken H <kanno41@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^4.1.2",
    "cli-table": "^0.3.11",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "moment": "^2.30.1",
    "ora": "^5.4.1",
    "puppeteer": "^25.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.4.2"
  }
}
